    {
      "type": "text", "nodeId": "top-slide", "text": "Slide from top",
      "motion": { "preset": "slideIn", "durationMs": 900, "direction": "top", "distance": 16, "easing": "easeOut" }
    },
    {
      "type": "text", "nodeId": "bottom-slide", "text": "Slide from bottom",
      "motion": { "preset": "slideIn", "durationMs": 900, "direction": "bottom", "distance": 16, "easing": "easeInOut" }
    },
    { "type": "text", "nodeId": "static", "text": "Static sibling", "backgroundColor": "#CDEFD6" },
